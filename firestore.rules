rules_version = '2';
// Reglas para la base "planificacion-financiera" del proyecto mira-87ec6.
// NO tocan la base "(default)" que usa la app Mira — son bases completamente
// separadas, cada una con sus propias reglas (ver AGENTS.md).
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo cuentas @ingevec.cl autenticadas (Google Sign-In) cuentan como "logueadas".
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@ingevec[.]cl$');
    }
    // Rol asignado en roles/{email}, o null si no tiene documento.
    function myRole() {
      return get(/databases/$(database)/documents/roles/$(request.auth.token.email)).data.role;
    }
    function hasRole() {
      return isSignedIn() && myRole() in ['editor', 'lector', 'dueño'];
    }
    function isAdmin() {
      return isSignedIn() && myRole() in ['editor', 'dueño'];
    }
    function isOwner() {
      return isSignedIn() && myRole() == 'dueño';
    }

    // roles/*: cualquier cuenta @ingevec.cl logueada puede leer su propio rol (y el de
    // otros, no hay dato sensible ahí). El dueño puede crear/actualizar roles desde la
    // pantalla "Usuarios" de la app, pero solo puede asignar 'editor' o 'lector' — nunca
    // 'dueño', que sigue siendo exclusivamente un paso manual por consola/CLI para evitar
    // que se cree un segundo dueño por error o de forma casual. Deliberadamente NO se usa
    // un wildcard genérico tipo /{collection}/{docId} para el resto de las colecciones: en
    // reglas de Firestore, un match más específico (como este) NO gana por sobre uno
    // genérico que también calce el mismo path — se evalúan todos y basta que uno permita
    // para que se permita. Listar las colecciones a mano evita ese solapamiento.
    match /roles/{email} {
      allow read: if isSignedIn();
      allow create, update: if isOwner() && request.resource.data.role in ['editor', 'lector'];
      allow delete: if isOwner();
    }

    match /categorias/{id} {
      allow read: if hasRole();
      allow write: if isAdmin();
    }
    match /proyectos/{id} {
      allow read: if hasRole();
      allow write: if isAdmin();
    }
    match /config/{id} {
      allow read: if hasRole();
      allow write: if isAdmin();
    }
    match /cajaReal/{id} {
      allow read: if hasRole();
      allow write: if isAdmin();
    }
    match /importLog/{id} {
      allow read: if hasRole();
      allow write: if isAdmin();
    }
    // Versiones guardadas del flujo de caja (snapshots). Append-only: solo se crean o borran,
    // nunca se editan, para que una versión guardada siga siendo fiel a lo que se vio ese día.
    match /snapshots/{id} {
      allow read: if hasRole();
      allow create, delete: if isAdmin();
      allow update: if false;
    }
  }
}
